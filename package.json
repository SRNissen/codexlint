{
  "name": "codexlint",
  "version": "0.0.1",
  "publisher": "SRNissen",
  "repository": {
    "type": "git",
    "url": "https://github.com/SRNissen/codexlint"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "license": "MIT",
  "displayName": "codexlint",
  "description": "Lint with Codex CLI",
  "categories": [
    "Linters"
  ],
  "preview": true,
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexlint.debugEnvironment",
        "title": "codexlint: Debug Environment"
      }
    ],
    "configuration": {
      "title": "codexlint",
      "properties": {
        "codexlint.onSave.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run codexlint security analysis when a file is saved."
        },
        "codexlint.onSave.debounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 0,
          "description": "Delay before launching analysis after save."
        },
        "codexlint.onSave.maxFileBytes": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "description": "Skip files larger than this size in bytes."
        },
        "codexlint.onSave.skipBinaryFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip files that look binary."
        },
        "codexlint.codex.command": {
          "type": "string",
          "default": "codex",
          "description": "Executable used to run codex analysis."
        },
        "codexlint.codex.args": {
          "type": "array",
          "default": [
            "exec"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed before the generated analysis prompt."
        },
        "codexlint.codex.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1,
          "description": "Maximum time to wait for codex exec output."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "compile": "tsc -p ./ && node prepare-dist.mjs && cd dist && vsce package",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.mts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module"
}
