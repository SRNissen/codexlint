{
  "name": "codexlint",
  "displayName": "codexlint",
  "description": "VS Code extension scaffold for codexlint.",
  "version": "0.0.1",
  "publisher": "SRNissen",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexlint.debugEnvironment",
        "title": "codexlint: Debug Environment"
      }
    ],
    "configuration": {
      "title": "codexlint",
      "properties": {
        "codexlint.onSave.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run codexlint security analysis when a file is saved."
        },
        "codexlint.onSave.debounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 0,
          "description": "Delay before launching analysis after save."
        },
        "codexlint.onSave.maxFileBytes": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "description": "Skip files larger than this size in bytes."
        },
        "codexlint.onSave.skipBinaryFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip files that look binary."
        },
        "codexlint.codex.command": {
          "type": "string",
          "default": "codex",
          "description": "Executable used to run codex analysis."
        },
        "codexlint.codex.args": {
          "type": "array",
          "default": [
            "exec"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed before the generated analysis prompt."
        },
        "codexlint.codex.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1,
          "description": "Maximum time to wait for codex exec output."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.mts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
