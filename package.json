{
  "name": "codexlint",
  "displayName": "codexlint",
  "version": "0.1.1",
  "publisher": "SRNissen",
  "description": "Lint with Codex CLI",
  "author": "SRNissen",
  "categories": [
    "Linters"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SRNissen/codexlint"
  },
  "bugs": {
    "url": "https://github.com/SRNissen/codexlint/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "license": "MIT",
  "preview": true,
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexlint.debugEnvironment",
        "title": "codexlint: Debug Environment"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codexlint.debugEnvironment",
          "when": "codexlint.showDebugEnvironmentCommand"
        }
      ]
    },
    "configuration": [
      {
        "title": "Analyzer Selection",
        "properties": {
          "codexlint.analyzer.command": {
            "type": "string",
            "default": "codexExec",
            "enum": [
              "codexExec",
              "claudeP",
              "custom"
            ],
            "enumItemLabels": [
              "codex exec",
              "claude -p",
              "custom"
            ],
            "description": "Choose which analyzer command preset to run."
          },
          "codexlint.analyzer.customCommand": {
            "type": "string",
            "default": "",
            "description": "Custom analyzer command text, for example: codex exec --model gpt-5. Ignored unless Analyzer Command is set to custom."
          },
          "codexlint.analyzer.customInput": {
            "type": "string",
            "default": "arg",
            "enum": [
              "arg",
              "stdin"
            ],
            "enumItemLabels": [
              "pass files as arg",
              "pass files as stdin"
            ],
            "description": "How codexlint passes prompt text to a custom analyzer command. Ignored for codex exec and claude -p presets."
          }
        }
      },
      {
        "title": "Prompt",
        "properties": {
          "codexlint.prompt.highlightSelectedSkills": {
            "type": "boolean",
            "default": false,
            "description": "Highlight selected skill names in the prompt text. Models can still access all skills regardless of this setting."
          },
          "codexlint.prompt.selectedSkills": {
            "type": "string",
            "default": "",
            "description": "Comma-separated or newline-separated skill names to highlight in the prompt."
          },
          "codexlint.prompt.customPrompt": {
            "type": "boolean",
            "default": false,
            "description": "Use a custom prompt template. See README.md for template guidance."
          },
          "codexlint.prompt.customPromptText": {
            "type": "string",
            "default": "",
            "description": "Custom prompt template. Ignored unless Use Custom Prompt is enabled."
          }
        }
      },
      {
        "title": "Operation",
        "properties": {
          "codexlint.operation.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Run codexlint security analysis when a file is saved."
          },
          "codexlint.operation.debounceMs": {
            "type": "number",
            "default": 750,
            "minimum": 0,
            "description": "Delay before launching analysis after save."
          },
          "codexlint.operation.minFileReanalyzeMs": {
            "type": "number",
            "default": 300000,
            "minimum": 0,
            "description": "Minimum time in milliseconds before rerunning analysis for the same file."
          },
          "codexlint.operation.maxFileBytes": {
            "type": "number",
            "default": 1000000,
            "minimum": 1,
            "description": "Skip files larger than this size in bytes."
          },
          "codexlint.operation.skipBinaryFiles": {
            "type": "boolean",
            "default": true,
            "description": "Skip files that look binary."
          },
          "codexlint.operation.timeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 1,
            "description": "Maximum time to wait for analyzer output."
          },
          "codexlint.operation.showDebugCommand": {
            "type": "boolean",
            "default": false,
            "description": "Show the 'codexlint: Debug Environment' command in the Command Palette."
          },
          "codexlint.operation.showDebugIO": {
            "type": "boolean",
            "default": false,
            "description": "Log analyzer request/response text to the codexlint output channel. Request logs omit file content."
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.10",
    "eslint": "^10.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "string-argv": "^0.3.2"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:tests",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=out/src/extension.js --sourcemap",
    "build:tests": "tsc -p ./tsconfig.test.json",
    "build:dist-no-audit": "npm run clean && npm run check && npm run build && npm run test:unit && npm run reset:test-workspace && npm run test:integration && node scripts/prepare-dist.mjs",
    "build:dist": "npm run build:dist-no-audit && npm  audit --omit=dev",
    "build:package": "npm run build:dist && npm run test:adversarial && node scripts/package-vsix.mjs",
    "clean": "npm run clean:dist && npm run clean:extension-output && npm run clean:test-output && npm run clean:test-workspace",
    "clean:dist": "node scripts/clean.mjs dist",
    "clean:extension-output": "node scripts/clean.mjs out/src",
    "clean:test-output": "node scripts/clean.mjs out/test",
    "clean:test-workspace": "node scripts/clean.mjs test-workspace",
    "check": "npm run check:lint && npm run check:typecheck",
    "check:lint": "eslint --config scripts/eslint.config.mjs \"src/**/*.ts\"",
    "check:typecheck": "tsc -p ./ --noEmit",
    "reset:test-workspace": "node scripts/reset-test-workspace.mjs",
    "test:adversarial": "vscode-test --config scripts/vscode-test.adversarial.mjs",
    "test:diagnostic-manual": "vscode-test --config scripts/vscode-test.diagnostic-manual.mjs",
    "test:diagnostic-manual:workspace-trust": "node scripts/test-workspace-trust-diagnostic.mjs",
    "test:integration": "vscode-test --config scripts/vscode-test.mjs --forbid-pending",
    "test:unit": "node --test test/unit/**/*.test.mjs",
    "watch": "node scripts/watch.mjs",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=out/src/extension.js --sourcemap --watch",
    "watch:tests": "tsc -p ./tsconfig.test.json --watch",
    "watch:typecheck": "tsc -p ./ --noEmit --watch"
  },
  "type": "module"
}
